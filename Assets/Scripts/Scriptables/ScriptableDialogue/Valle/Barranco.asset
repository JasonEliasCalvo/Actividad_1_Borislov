  m_Script: {fileID: 11500000, guid: 51fc989f0f5de3043b8ea24d0f9ab57c, type: 3}
  m_Name: Barranco
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueLines:
  - text: "Las mutaciones aceleradas en los espec\xEDmenes tipo 'Manny' han provocado
      una inestabilidad qu\xEDmica en sus n\xFAcleos. Al detectar calor corporal,
      la toxina se expande hasta estallar... Un da\xF1o colateral aceptable."
    portrait: {fileID: 21300000, guid: 4c3445e065b80104f8a32b0376a9a0c1, type: 3}
  - text: "Pete los est\xE1 usando como minas vivientes... Vaya pedazo de desalmado."
    portrait: {fileID: 21300000, guid: d072a5b7401177c48bb0192ed284f942, type: 3}
  dialogueID: 2
